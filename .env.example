# === API Keys ===
OPENAI_API_KEY=sk-...
PEXELS_API_KEY=...
GOOGLE_TTS_API_KEY=...

# === OpenAI Settings ===
# Recommended: gpt-4o or gpt-4o-mini
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# === Google TTS Settings ===
# Language code e.g. en-US, es-ES, fr-FR, de-DE, pt-BR, hi-IN, ja-JP
GOOGLE_TTS_LANGUAGE_CODE=en-US
# Voice name — see https://cloud.google.com/text-to-speech/docs/voices
# Leave blank to auto-select a standard voice for the language
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-F
# AUDIO_ENCODING: MP3 | OGG_OPUS | LINEAR16
GOOGLE_TTS_AUDIO_ENCODING=MP3
# Speaking rate: 0.25 – 4.0  (1.0 = normal)
GOOGLE_TTS_SPEAKING_RATE=1.1
# Pitch: -20.0 – 20.0 semitones
GOOGLE_TTS_PITCH=0.0

# === Pexels Settings ===
PEXELS_PER_PAGE=5
PEXELS_VIDEO_MIN_DURATION=3
PEXELS_VIDEO_MAX_DURATION=15

# === Output ===
OUTPUT_DIR=output
